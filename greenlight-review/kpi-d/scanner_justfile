# justfile

workspace_target := "../../target"
bench_binary := "bench_runner"

default:
    @just --list

setup:
    @echo "[+] Setting up fixtures..."
    python3 tests/fixtures/fetch_eicar.py
    python3 tests/fixtures/generate_fixtures.py
    python3 tests/fixtures/generate_heavy_fs.py

test: setup
    @echo "[+] Running Cargo tests for the scanner..."
    cargo test

bench: setup
    @echo "[+] Building release binary..."
    cargo build --release --bin {{bench_binary}}
    
    @echo "[+] Running benchmarks..."
    python3 tests/bench/bench_scan.py \
      --binary {{workspace_target}}/release/{{bench_binary}} \
      --target tests/fixtures/heavy_fs \
      --sweep-threads 1,2,4,auto \
      --iterations 3

clean:
    @echo "[+] Cleaning up generated test files..."
    rm -rf tests/fixtures/dummy_fs
    rm -rf tests/fixtures/heavy_fs
    rm -f tests/fixtures/eicar*