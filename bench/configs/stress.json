{
  "profile": "safe",
  "dry_run": false,
  "root_paths": ["/"],
  "max_log_retention_days": 7,
  "max_log_size_gb": 1.0,
  "min_bigfile_size_mb": 50,
  "enable_system_cache": true,
  "enable_user_cache": true,
  "enable_browser_cache": true,
  "enable_dev_cache": true,
  "enable_package_cache": true,
  "enable_desktop_cache": true
}